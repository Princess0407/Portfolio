# Required for the contribution heatmap (GitHub GraphQL contributionsCalendar).
# Also used for authenticated pull-request lookups.
# Set this in Vercel project settings and in a local .env file.
# Do not prefix with PUBLIC_ — the token must stay on the server.
GITHUB_PAT=

# Optional. Home page contact form (/api/reach).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
