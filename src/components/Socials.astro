---
import { resumeHref, socials } from '../data/profile';

const icons: Record<string, string> = {
  GitHub:
    'M12 .3C5.4.3 0 5.7 0 12.3c0 5.3 3.4 9.8 8.2 11.4.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.6-4-1.6-.5-1.4-1.3-1.8-1.3-1.8-1.1-.8.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 24 12.3C24 5.7 18.6.3 12 .3z',
  X: 'M18.2 2.3h3.3l-7.2 8.3L23 21.8h-6.2l-4.9-6.4-5.6 6.4H3.1l7.7-8.8L1.3 2.3h6.4l4.4 5.8 6.1-5.8zm-1.2 17.5h1.8L7.1 4.1H5.2l11.8 15.7z',
  LinkedIn:
    'M4.98 3.5C4.98 4.88 3.88 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.24 8.5h4.52V24H.24V8.5zM8.34 8.5h4.33v2.12h.06c.6-1.14 2.08-2.34 4.28-2.34 4.58 0 5.42 3.01 5.42 6.93V24h-4.52v-7.7c0-1.84-.03-4.2-2.56-4.2-2.56 0-2.95 2-2.95 4.06V24H8.34V8.5z',
  Mail: 'M2 5.5h20v13H2v-13zm1.4 1.2 8.6 6.2 8.6-6.2H3.4zm17.2 1.1-7.7 5.5c-.5.4-1.2.4-1.8 0L3.4 7.8V17.3h17.2V7.8z',
};
---
<div class="social-row">
  {socials.map((item) => (
    <a class="icon-link" href={item.href} aria-label={item.label} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d={icons[item.label]}></path>
      </svg>
    </a>
  ))}
  <a class="btn" href={resumeHref} target="_blank" rel="noreferrer">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M6 2h8l6 6v14H6V2zm7 1.5V9h5.5L13 3.5zM8 12h8v1.4H8V12zm0 3h8v1.4H8V15zm0 3h5v1.4H8V18z"></path>
    </svg>
    resume
  </a>
</div>
