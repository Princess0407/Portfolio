---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const poems = (await getCollection('poems')).sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
const rendered = await Promise.all(poems.map(async (poem) => ({ poem, Content: (await poem.render()).Content })));
---
<Base title="Poems — Priyanka" description="Poems by Priyanka Tiwari.">
  <p class="kicker">~ poems</p>
  <div class="poem-list">
    {rendered.map(({ poem, Content }) => (
      <article class="poem">
        <h1>{poem.data.title}</h1>
        <p class="meta">{poem.data.date}{poem.data.readTime ? ` · ${poem.data.readTime}` : ''}</p>
        <div class="poem-body">
          <Content />
        </div>
      </article>
    ))}
  </div>
</Base>
