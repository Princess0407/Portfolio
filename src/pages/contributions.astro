---
import Base from '../layouts/Base.astro';
---
<Base title="Contributions — Priyanka" description="Pull requests authored by Princess0407.">
  <p class="kicker">~ contributions</p>
  <h1 class="post-title">Pull requests</h1>
  <p class="note" id="pr-status">Loading pull requests…</p>
  <ol class="timeline" id="pr-list"></ol>
</Base>

<script>
  type Pull = {
    title: string;
    url: string;
    repo: string;
    state: 'merged' | 'open' | 'closed';
    date: string;
  };

  const status = document.getElementById('pr-status');
  const list = document.getElementById('pr-list');

  function formatDate(iso: string) {
    const [year, month, day] = iso.slice(0, 10).split('-').map(Number);
    return new Date(Date.UTC(year, month - 1, day)).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    });
  }

  function mergeIcon() {
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('viewBox', '0 0 16 16');
    svg.setAttribute('aria-hidden', 'true');
    svg.classList.add('merge-icon');
    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('fill', 'none');
    path.setAttribute('stroke', 'currentColor');
    path.setAttribute('stroke-width', '1.4');
    path.setAttribute('d', 'M4 4.8v6.4M4 8h6.3');
    ['4,3.2', '4,12.8', '12,8'].forEach((pair) => {
      const [cx, cy] = pair.split(',');
      const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      circle.setAttribute('cx', cx);
      circle.setAttribute('cy', cy);
      circle.setAttribute('r', '1.55');
      circle.setAttribute('fill', 'none');
      circle.setAttribute('stroke', 'currentColor');
      circle.setAttribute('stroke-width', '1.4');
      svg.append(circle);
    });
    svg.append(path);
    return svg;
  }

  function render(pulls: Pull[]) {
    if (!list || !status) return;
    list.replaceChildren();
    if (!pulls.length) {
      status.textContent = 'No pull requests found for Princess0407.';
      return;
    }
    status.textContent = `${pulls.length} pull requests by Princess0407`;
    pulls.forEach((pull) => {
      const item = document.createElement('li');
      item.className = 'pr';
      const link = document.createElement('a');
      link.href = pull.url;
      link.target = '_blank';
      link.rel = 'noreferrer';
      const title = document.createElement('span');
      title.className = 'pr-title';
      if (pull.state === 'merged') title.append(mergeIcon());
      const text = document.createElement('span');
      text.textContent = pull.title;
      title.append(text);
      link.append(title);
      const meta = document.createElement('p');
      meta.className = 'pr-meta';
      meta.textContent = `${pull.repo} · ${pull.state} · ${formatDate(pull.date)}`;
      item.append(link, meta);
      list.append(item);
    });
  }

  async function load() {
    try {
      const response = await fetch('/api/contributions');
      const payload = (await response.json()) as { pulls?: Pull[]; error?: string };
      if (!response.ok) throw new Error(payload.error || 'Could not load pull requests.');
      render(payload.pulls ?? []);
    } catch (error) {
      if (status) status.textContent = error instanceof Error ? error.message : 'Could not load pull requests.';
    }
  }

  load();
</script>
