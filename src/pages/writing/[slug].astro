---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---
<Base title={`${post.data.title} — Priyanka`} description={post.data.description}>
  <a class="back" href="/writing">← writing</a>
  <p class="meta">{[post.data.topic, post.data.date].filter(Boolean).join(' · ')}</p>
  <h1 class="post-title">{post.data.title}</h1>
  {post.data.description && <p class="lede">{post.data.description}</p>}
  <article class="prose">
    <Content />
  </article>
</Base>
