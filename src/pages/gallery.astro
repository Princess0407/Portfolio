---
import Base from '../layouts/Base.astro';
---
<Base title="Gallery — Princess" activeTab="gallery">
<div class="page">
  <div class="section" style="padding-top:48px">
    <p class="section-label">Visual</p>
    <h1 class="section-title">Gallery</h1>
    <div class="divider"></div>
    <div class="gallery-grid">
      <div class="gallery-item"><img src="/gallery/20250517_183418.jpg" alt="Gallery image" loading="lazy" /></div>
      <div class="gallery-item"><img src="/gallery/20250804_182238.jpg" alt="Gallery image" loading="lazy" /></div>
      <div class="gallery-item"><img src="/gallery/20250727_183109.jpg" alt="Gallery image" loading="lazy" /></div>
      <div class="gallery-item"><img src="/gallery/IMG-20260714-WA0083.jpg" alt="Gallery image" loading="lazy" /></div>
      <div class="gallery-item"><img src="/gallery/20240926_174911.jpg" alt="Gallery image" loading="lazy" /></div>
      <div class="gallery-item"><img src="/gallery/20251124_174221.jpg" alt="Gallery image" loading="lazy" /></div>
      <div class="gallery-item"><img src="/gallery/20240527_164200.jpg" alt="Gallery image" loading="lazy" /></div>
      <div class="gallery-item"><img src="/gallery/20241205_172129.jpg" alt="Gallery image" loading="lazy" /></div>
      <div class="gallery-item"><img src="/gallery/IMG-20240423-WA0040.jpg" alt="Gallery image" loading="lazy" /></div>
    </div>
  </div>
</div>
</Base>

<style>
.gallery-hint {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.75rem;
  color: var(--text-faint);
  line-height: 1.7;
  margin-bottom: 24px;
}
.gallery-hint code {
  background: var(--skill-bg);
  padding: 1px 6px;
  border-radius: 4px;
  color: var(--accent);
}
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 12px;
}
.gallery-item {
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid var(--border-card);
  aspect-ratio: 1;
  background: var(--bg-card);
}
.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s;
}
.gallery-item:hover img { transform: scale(1.03); }
.gallery-placeholder {
  grid-column: 1/-1;
  text-align: center;
  padding: 60px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.72rem;
  color: var(--text-faint);
  letter-spacing: 0.06em;
  border: 1px dashed var(--border-card);
  border-radius: 14px;
}
</style>
