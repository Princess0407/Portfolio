---
import Base from '../layouts/Base.astro';
---
<Base title="Reach out — Princess" activeTab="reach">
<div class="page">
  <div class="section" style="padding-top:48px">
    <p class="section-label">Contact</p>
    <h1 class="section-title">Reach out</h1>
    <div class="divider"></div>
    <p class="reach-bio">
      Open to internship conversations, collaboration on AI infrastructure or embedded projects,
      and genuine technical exchanges. No cold pitches.
    </p>
    <!-- Replace YOUR_FORM_ID with your Formspree form ID from formspree.io -->
    <form class="reach-form" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
      <input class="reach-input" type="text" name="name" placeholder="your name" required/>
      <input class="reach-input" type="email" name="email" placeholder="your email" required/>
      <textarea class="reach-input reach-textarea" name="message" placeholder="what's on your mind" required></textarea>
      <button class="reach-btn" type="submit">Send message</button>
    </form>
    <div class="social-row">
      <a class="hero-link" href="https://github.com/Princess0407" target="_blank">GitHub</a>
      <a class="hero-link" href="https://x.com" target="_blank">X / Twitter</a>
      <a class="hero-link" href="https://linkedin.com" target="_blank">LinkedIn</a>
    </div>
  </div>
</div>
</Base>

<style>
.reach-bio { font-size: 1.05rem; color: var(--text-muted); line-height: 1.8; margin-bottom: 32px; max-width: 480px; }
.reach-form { display: flex; flex-direction: column; gap: 14px; max-width: 460px; margin-bottom: 32px; }
.reach-input {
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: 10px;
  padding: 12px 16px;
  font-family: 'EB Garamond', Georgia, serif;
  font-size: 1rem;
  color: var(--text);
  outline: none;
  transition: border-color 0.2s;
  width: 100%;
}
.reach-input:focus { border-color: var(--accent); }
.reach-input::placeholder { color: var(--text-faint); }
.reach-textarea { min-height: 130px; resize: vertical; }
.reach-btn {
  padding: 12px 28px;
  border-radius: 50px;
  border: none;
  background: var(--accent);
  color: #fff;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.78rem;
  letter-spacing: 0.06em;
  cursor: pointer;
  transition: opacity 0.2s, transform 0.15s;
  align-self: flex-start;
}
.reach-btn:hover { opacity: 0.85; transform: translateY(-1px); }
.social-row { display: flex; gap: 10px; flex-wrap: wrap; }
</style>
