---
import Base from '../layouts/Base.astro';
---
<Base title="Priyanka Tiwari" activeTab="home">

<div class="page">

  <!-- BANNER -->
  <div class="banner-wrap">
    <img class="banner-img" id="banner-img" src="" alt="Banner"/>
  </div>

  <!-- HERO -->
  <div class="hero">
    <h1 class="hero-name">Priyanka <em>Tiwari.</em></h1>
    <p class="hero-role">Curious&nbsp;·&nbsp; Systems Builder &nbsp;
    <p class="hero-bio">
      I love building things where hardware gets opinionated about software.
    </p>
    <p class="hero-location">⌖ Bangalore, India</p>
    <div class="hero-links">
      <a class="hero-link" href="https://github.com/Princess0407" target="_blank">
        <svg viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        GitHub
      </a>
      <a class="hero-link" href="https://www.linkedin.com/in/priyanka-tiwari-2b0992263/" target="_blank">
        <svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        LinkedIn
      </a>
      <a class="hero-link" href="https://x.com/PriyankaBard" target="_blank">
        <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        X / Twitter
      </a>
      <a class="hero-link" href="/Resume-3.pdf" target="_blank" id="resume-btn">
        <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zm4 18H6V4h7v5h5zM8 15h8v1H8zm0-3h8v1H8zm0-3h5v1H8z" fill="currentColor"/></svg>
        Resume
      </a>
    </div>
  </div>

  <!-- ABOUT -->
  <div class="section">
    <p class="section-label">About</p>
    <h2 class="section-title">Me</h2>
    <div class="divider"></div>
    <p class="about-text">
      I am a poet who was once lost in engineering but now loves it. That beauty that I find in this domain is insane. In the inital days, I learnt many things, you can see that in my polar opposite projects that I've built till now.
      Right now I've chose working in <i>ML inference & Security Tooling</i> and have started building projects which are under wraps for now!!
      Outisde this you can find my reading research papers during my classes <i>(during slow moving lecs)</i> or penning poetries.
    </p>
  </div>

  <!-- SKILLS -->
  <div class="section">
    <p class="section-label">Skills</p>
    <h2 class="section-title">What I work with</h2>
    <div class="divider"></div>
    <div class="skills-wrap">
      {['C','C++','Python','Verilog','TypeScript','JavaScript','React','Next.js',
        'Node.js','Tailwind CSS','Linux','Git','AST / Parsing','Embedded Systems','Machine Learning',
        'KiCad','Low Level Design','AI on Edge','LLM Security','System Design',
      ].map(s => <span class="skill-tag">{s}</span>)}
    </div>
  </div>

  <!-- PROJECTS -->
  <div class="section">
    <p class="section-label">Projects</p>
    <h2 class="section-title">Pinned repositories</h2>
    <div class="divider"></div>
    <div class="repos-grid" id="repos-container">
      <p class="repo-loading">Fetching from GitHub...</p>
    </div>
  </div>

  <!-- HEATMAP -->
  <div class="section">
    <p class="section-label">Activity</p>
    <h2 class="section-title">Commit heatmap</h2>
    <div class="divider"></div>
    <div class="heatmap-wrap frost-card">
      <p class="heatmap-title" id="heatmap-label">Princess0407 · last 52 weeks</p>
      <div id="heatmap-container" style="overflow-x:auto;"></div>
      <div class="heatmap-legend">
        <span>less</span>
        <div class="legend-cell" style="background:var(--heat-0)"></div>
        <div class="legend-cell" style="background:var(--heat-1)"></div>
        <div class="legend-cell" style="background:var(--heat-2)"></div>
        <div class="legend-cell" style="background:var(--heat-3)"></div>
        <div class="legend-cell" style="background:var(--heat-4)"></div>
        <span>more</span>
      </div>
    </div>
  </div>

  <!-- RESUME MODAL -->
  <div id="resume-modal" class="resume-modal">
    <div class="resume-modal-content frost-card">
      <button id="resume-close" class="resume-close">&times;</button>
      <div id="resume-canvas-container" class="resume-canvas-container">
        <div id="resume-loader" class="resume-loader">Loading resume...</div>
      </div>
    </div>
  </div>

</div>
</Base>

<style>
.banner-wrap { width: calc(100% + 48px); margin: 0 -24px; overflow: hidden; }
.banner-img { width: 100%; height: 280px; object-fit: cover; object-position: center 40%; border-radius: 0 0 24px 24px; display: block; }
.hero { text-align: center; padding: 52px 0 40px; }
.hero-name { font-size: clamp(2.2rem,6vw,3.6rem); font-weight: 500; letter-spacing: -0.02em; line-height: 1.1; }
.hero-name em { font-style: italic; color: var(--accent); }
.hero-role { font-family: 'JetBrains Mono',monospace; font-size: 0.8rem; color: var(--text-muted); letter-spacing: 0.12em; text-transform: uppercase; margin-top: 10px; }
.hero-bio { max-width: 520px; margin: 20px auto 0; font-size: 1.05rem; color: var(--text-muted); line-height: 1.75; }
.hero-location { font-family: 'JetBrains Mono',monospace; font-size: 0.75rem; color: var(--text-faint); margin-top: 14px; letter-spacing: 0.06em; }
.hero-links { display: flex; justify-content: center; gap: 10px; margin-top: 26px; flex-wrap: wrap; }
.about-text { font-size: 1.05rem; line-height: 1.85; color: var(--text-muted); }
.about-text strong { color: var(--text); font-weight: 500; }
.skills-wrap { display: flex; flex-wrap: wrap; gap: 9px; }
.repos-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(280px,1fr)); gap: 16px; }
</style>

<style is:global>
.repo-loading { font-family: 'JetBrains Mono',monospace; font-size: 0.78rem; color: var(--text-faint); text-align: center; padding: 32px; grid-column: 1/-1; }
.repo-card { background: var(--bg-frost); border: 1px solid var(--border-card); border-radius: 18px; padding: 22px; backdrop-filter: blur(16px); box-shadow: var(--shadow-card); transition: transform 0.2s,box-shadow 0.2s,border-color 0.2s; cursor: pointer; text-decoration: none; display: block; color: inherit; }
.repo-card:hover { transform: translateY(-3px); border-color: var(--accent); box-shadow: 0 8px 32px rgba(124,111,207,0.15),0 0 0 1px var(--accent); }
.repo-name { font-size: 1rem; font-weight: 600; font-family: 'JetBrains Mono',monospace; color: var(--accent); margin-bottom: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.repo-desc { font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 14px; min-height: 42px; }
.repo-meta { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
.repo-lang { display: flex; align-items: center; gap: 5px; font-family: 'JetBrains Mono',monospace; font-size: 0.7rem; color: var(--text-faint); }
.lang-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
.repo-stars { font-family: 'JetBrains Mono',monospace; font-size: 0.7rem; color: var(--text-faint); }
</style>

<style>
.heatmap-wrap { padding: 24px; }
.heatmap-title { font-family: 'JetBrains Mono',monospace; font-size: 0.72rem; color: var(--text-faint); letter-spacing: 0.06em; margin-bottom: 14px; }
.heatmap-legend { display: flex; align-items: center; gap: 4px; margin-top: 10px; font-family: 'JetBrains Mono',monospace; font-size: 0.65rem; color: var(--text-faint); }
.legend-cell { width: 11px; height: 11px; border-radius: 3px; }
.resume-modal {
  display: none;
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  z-index: 9999;
  justify-content: center;
  align-items: center;
  padding: 20px;
}
.resume-modal.active {
  display: flex;
}
.resume-modal-content {
  position: relative;
  width: 100%;
  max-width: 800px;
  height: 85vh;
  border-radius: var(--radius-card);
  overflow: hidden;
  box-shadow: 0 10px 40px rgba(0,0,0,0.3);
}
.resume-close {
  position: absolute;
  top: 12px;
  right: 18px;
  background: var(--bg-card);
  border: 1px solid var(--border-card);
  border-radius: 50%;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  color: var(--text-muted);
  cursor: pointer;
  z-index: 10;
  transition: all 0.2s;
}
.resume-close:hover {
  color: var(--accent);
  border-color: var(--accent);
}
.resume-iframe {
  width: 100%;
  height: 100%;
  border: none;
  background: #fff;
}
.resume-canvas-container {
  width: 100%;
  height: 100%;
  overflow-y: auto;
  background: var(--bg);
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.resume-loader {
  font-family: 'JetBrains Mono', monospace;
  color: var(--text-faint);
  font-size: 0.85rem;
  margin-top: 40px;
}
@media(max-width:600px) { .banner-img { height: 180px; } .hero-name { font-size: 2rem; } .repos-grid { grid-template-columns: 1fr; } }
</style>

<script>
const DARK_SRC = '/banners/dark.png';
const LIGHT_SRC = '/banners/light.png';

const bannerImg = document.getElementById('banner-img');
function updateBanner() {
  const theme = document.documentElement.getAttribute('data-theme');
  if (bannerImg) bannerImg.src = theme === 'dark' ? DARK_SRC : LIGHT_SRC;
}
updateBanner();
document.getElementById('theme-toggle')?.addEventListener('click', () => setTimeout(updateBanner, 10));

// Resume Modal & PDF.js Logic
const resumeBtn = document.getElementById('resume-btn');
const resumeModal = document.getElementById('resume-modal');
const resumeClose = document.getElementById('resume-close');
const canvasContainer = document.getElementById('resume-canvas-container');

let pdfLoaded = false;

async function renderPDF() {
  if (pdfLoaded) return;
  const loader = document.getElementById('resume-loader');
  
  if (!window.pdfjsLib) {
    loader.innerText = 'Loading PDF engine...';
    const script = document.createElement('script');
    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
    document.body.appendChild(script);
    
    await new Promise(resolve => script.onload = resolve);
    window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  }

  try {
    loader.innerText = 'Rendering resume...';
    const loadingTask = window.pdfjsLib.getDocument('/Resume-3.pdf');
    const pdfDoc = await loadingTask.promise;
    
    loader.style.display = 'none';
    pdfLoaded = true;

    for (let num = 1; num <= pdfDoc.numPages; num++) {
      const page = await pdfDoc.getPage(num);
      const viewport = page.getViewport({ scale: 2 }); // High-res render
      
      const wrapper = document.createElement('div');
      wrapper.style.position = 'relative';
      wrapper.style.width = '100%';
      wrapper.style.maxWidth = (viewport.width / 2) + 'px';
      wrapper.style.marginBottom = '20px';
      wrapper.style.borderRadius = '4px';
      wrapper.style.boxShadow = '0 4px 12px rgba(0,0,0,0.15)';
      wrapper.style.background = '#fff';
      
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      canvas.width = viewport.width;
      canvas.height = viewport.height;
      
      // CSS scaling for retina sharpness
      canvas.style.width = '100%';
      canvas.style.height = 'auto';
      canvas.style.display = 'block';
      canvas.style.borderRadius = '4px';
      
      wrapper.appendChild(canvas);
      canvasContainer.appendChild(wrapper);
      
      await page.render({ canvasContext: ctx, viewport: viewport }).promise;

      // Extract links and overlay them
      try {
        const annotations = await page.getAnnotations();
        // The canvas is scaled by 2 internally but displayed at scale 1 via CSS
        // So we calculate viewport at scale 1 for the invisible link overlays
        const cssViewport = page.getViewport({ scale: (wrapper.clientWidth / (viewport.width / 2)) });
        
        annotations.forEach(anno => {
          if (anno.subtype === 'Link' && anno.url) {
            const rect = cssViewport.convertToViewportRectangle(anno.rect);
            const minX = Math.min(rect[0], rect[2]);
            const maxX = Math.max(rect[0], rect[2]);
            const minY = Math.min(rect[1], rect[3]);
            const maxY = Math.max(rect[1], rect[3]);
            
            const link = document.createElement('a');
            link.href = anno.url;
            link.target = '_blank';
            link.style.position = 'absolute';
            link.style.left = minX + 'px';
            link.style.top = minY + 'px';
            link.style.width = (maxX - minX) + 'px';
            link.style.height = (maxY - minY) + 'px';
            link.style.zIndex = '10';
            link.style.cursor = 'pointer';
            // link.style.background = 'rgba(255,0,0,0.2)'; // Debug
            
            wrapper.appendChild(link);
          }
        });
      } catch (annoErr) {
        console.error('Failed to parse links', annoErr);
      }
    }
  } catch (err) {
    console.error('PDF Load Error:', err);
    loader.innerText = 'Failed to load PDF. Please try again.';
  }
}

if (resumeBtn && resumeModal && resumeClose) {
  resumeBtn.addEventListener('click', (e) => {
    e.preventDefault();
    resumeModal.classList.add('active');
    renderPDF(); // Triggers only on first open
  });

  resumeClose.addEventListener('click', () => {
    resumeModal.classList.remove('active');
  });

  resumeModal.addEventListener('click', (e) => {
    if (e.target === resumeModal) {
      resumeModal.classList.remove('active');
    }
  });
}

// Fallback removed to ensure only actual pinned repositories from GitHub are displayed.

async function loadGithubData() {
  try {
    const res = await fetch('/api/github');
    if (!res.ok) throw new Error('api error');
    const json = await res.json();
    
    // 1. Pinned Repos
    const repos = json.data?.user?.pinnedItems?.nodes;
    const container = document.getElementById('repos-container');
    if (container) {
      if (!repos?.length) {
        container.innerHTML = '<p class="repo-loading">No pinned repositories found.</p>';
      } else {
        container.innerHTML = '';
        repos.forEach(r => {
          const card = document.createElement('a');
          card.className = 'repo-card';
          card.href = r.url;
          card.target = '_blank';
          card.innerHTML = `<div class="repo-name">${r.name}</div><div class="repo-desc">${r.description || 'No description.'}</div><div class="repo-meta">${r.primaryLanguage ? `<span class="repo-lang"><span class="lang-dot" style="background:${r.primaryLanguage.color}"></span>${r.primaryLanguage.name}</span>` : ''}<span class="repo-stars">★ ${r.stargazerCount}</span></div>`;
          container.appendChild(card);
        });
      }
    }

    // 2. Heatmap
    const calendar = json.data?.user?.contributionsCollection?.contributionCalendar;
    if (calendar) {
      buildHeatmap(calendar);
    }
  } catch { 
    const container = document.getElementById('repos-container');
    if (container) {
      container.innerHTML = '<p class="repo-loading" style="color: #ff5555;">Failed to load data. Please ensure your GITHUB_PAT is set in .env</p>';
    }
  }
}

function buildHeatmap(calendar) {
  const container = document.getElementById('heatmap-container');
  if (!container) return;
  const weeks = 52, days = 7, cell = 13, gap = 3;
  const w = weeks * (cell + gap) - gap, h = days * (cell + gap) - gap;
  
  const cells = [];
  if (calendar) {
    const ghWeeks = calendar.weeks.slice(-weeks);
    ghWeeks.forEach((week, wk) => {
      week.contributionDays.forEach(day => {
        const dayOfWeek = new Date(day.date).getDay();
        cells.push({ wk, d: dayOfWeek, count: day.contributionCount, date: new Date(day.date) });
      });
    });
    
    // Update total contributions label
    const label = document.getElementById('heatmap-label');
    if (label) label.innerText = `Princess0407 · ${calendar.totalContributions} contributions in the last year`;
  }

  const colors = ['var(--heat-0)','var(--heat-1)','var(--heat-2)','var(--heat-3)','var(--heat-4)'];
  const getC = c => c===0?colors[0]:c<2?colors[1]:c<4?colors[2]:c<7?colors[3]:colors[4];
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  let mlabels = '', last = -1;
  for (let wk = 0; wk < weeks; wk++) {
    const firstCellInWk = cells.find(c => c.wk === wk);
    if (firstCellInWk) {
      const m = firstCellInWk.date.getMonth();
      if (m !== last) { 
        mlabels += `<text x="${wk*(cell+gap)}" y="-5" style="font-family:monospace;font-size:9px;fill:var(--text-faint)">${months[m]}</text>`; 
        last = m; 
      }
    }
  }
  const dlabels = ['','Mon','','Wed','','Fri',''].map((l,i) => l?`<text x="-4" y="${i*(cell+gap)+cell-2}" text-anchor="end" style="font-family:monospace;font-size:9px;fill:var(--text-faint)">${l}</text>`:'').join('');
  const rects = cells.map(c => `<rect x="${c.wk*(cell+gap)}" y="${c.d*(cell+gap)}" width="${cell}" height="${cell}" rx="3" style="fill:${getC(c.count)};transition:fill 0.3s"><title>${c.count} contributions on ${c.date.toDateString()}</title></rect>`).join('');
  container.innerHTML = `<svg viewBox="-30 -20 ${w+40} ${h+30}" width="${w+40}" xmlns="http://www.w3.org/2000/svg">${mlabels}${dlabels}${rects}</svg>`;
}

loadGithubData();
</script>
