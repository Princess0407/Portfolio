---
import Base from '../layouts/Base.astro';
import Socials from '../components/Socials.astro';
import GithubPanels from '../components/GithubPanels.astro';
import Connect from '../components/Connect.astro';
import { experience, site, skills } from '../data/profile';
---
<Base title={site.name} description={site.lede}>
  <section class="whoami">
    <img class="wisteria wisteria-light" src="/wisteria-light.png" alt="" width="256" height="278" />
    <img class="wisteria wisteria-dark" src="/wisteria-dark.png" alt="" width="256" height="278" />
    <p class="kicker">~ whoami</p>
    <h1>{site.name}</h1>
    <p class="role">{site.role}</p>
    <p class="lede">{site.lede}</p>
    <p class="focus">› {site.focus}</p>
    <p class="loc">{site.location}</p>
    <p class="about">{site.about}</p>
  </section>

  <section class="block">
    <h2 class="prompt">~ cat skills.log</h2>
    <ul class="chips">
      {skills.map((skill) => <li class="chip">{skill}</li>)}
    </ul>
  </section>

  <section class="block">
    <Socials />
  </section>

  <GithubPanels />

  <section class="block">
    <h2 class="prompt">~ cat experience.log</h2>
    <ol class="timeline">
      {experience.map((item) => (
        <li class="exp">
          <p><strong>{item.title}</strong> — {item.place}</p>
          <p class="meta">{item.when}</p>
          {item.detail && <p>{item.detail}</p>}
        </li>
      ))}
    </ol>
  </section>

  <Connect />
</Base>
